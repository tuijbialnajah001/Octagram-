{
  "entities": {
    "Group": {
      "title": "Group",
      "description": "WhatsApp group information.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "time": { "type": "string" },
        "joinLink": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "community": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "imageUrl", "joinLink", "isPublic", "community"]
    },
    "DailyStat": {
      "title": "Daily Stat",
      "description": "Website visits indexed by date.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "timestamp": { "type": "number" },
        "count": { "type": "number" }
      },
      "required": ["date", "timestamp", "count"]
    }
    "LinkRequest": {
      "title": "Link Request",
      "description": "Request for a new join link if the current one is broken.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "groupTitle": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "createdAt": { "type": "number" }
      },
      "required": ["groupId", "groupTitle", "status", "createdAt"]
    }
  },
  "firestore": {
    "/link_requests/{requestId}": {
      "schema": { "$ref": "#/entities/LinkRequest" },
      "description": "Requests for new group links."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Public WhatsApp groups."
    },
    "/daily_stats/{dateStr}": {
      "schema": { "$ref": "#/entities/DailyStat" },
      "description": "Stats aggregated by day."
    }
  }
}
